# ──────────────────────────────────────────────────────────────────────────────
# TalentIQ Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="TalentIQ API"
APP_VERSION="2.0.0"
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/talentiq

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS (comma-separated) ────────────────────────────────────────────────────
# Add your frontend domain here
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── File Upload ────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── GitHub (Optional) ─────────────────────────────────────────────────────────
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your-github-personal-access-token-here
